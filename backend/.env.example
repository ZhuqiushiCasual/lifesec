# 数据库：不设则走本地 SQLite（开箱即跑）；生产用 MySQL
# DATABASE_URL=sqlite+aiosqlite:///./selfsec.db
DATABASE_URL=mysql+asyncmy://root:CHANGE_ME@localhost:3306/selfsec?charset=utf8mb4

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_API_KEY=

# 非空时所有 /api/* 需带请求头 X-API-Token 与之匹配；留空则不鉴权（仅限本地）
API_TOKEN=

# ── 内置调度 ──────────────────────────────────────────────
SCHEDULER_ENABLED=1
TZ_OFFSET_HOURS=8
MORNING_HOUR=8      # 早问候
EVENING_HOUR=21     # 晚问候 + 重算长期画像

# ── 记忆层 ────────────────────────────────────────────────
PROFILE_TRIGGER_EVENTS=20   # 新增事件数达到该值即重算画像
SESSION_WINDOW=6            # 注入 prompt 的最近对话轮数
